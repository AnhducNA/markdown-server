# Output directory configuration
OUTPUT_DIR=./output
MARKDOWN_OUTPUT_DIR=./output/markdown
ASSET_OUTPUT_DIR=./output/assets
MANIFEST_OUTPUT_DIR=./output/manifest
TMP_DIR=./tmp

# Markdown formatting options
MARKDOWN_INCLUDE_FRONTMATTER=true
MARKDOWN_INCLUDE_PAGE_MARKERS=true
MARKDOWN_ASSET_DIR=assets
MARKDOWN_MAX_BLANK_LINES=1
MARKDOWN_ENCODING=utf-8
MARKDOWN_STRICT_VALIDATION=false

# OCR Configuration
OCR_ENABLED=true
OCR_ENGINE=paddleocr
OCR_MIN_TEXT_CHARS=30
OCR_MIN_TEXT_DENSITY=0.0005
OCR_LANG=vi
OCR_FORCE=false
PDF_RENDER_DPI=200
OUTPUT_OVERWRITE=true

# Server Configuration
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1
